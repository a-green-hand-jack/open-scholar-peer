# External references — kept locally for inspiration but not part of OSP
reviewer-os/

# Leftover unrelated tooling at repo root.
# (NOT to be confused with the OSP Antigravity adapter at extensions/.agents/, which IS tracked.)
/.agents/

# Per-project runtime artifacts (created by installers in *user* projects, never in this dev repo)
.brain/
.scholar-peer/
# Anchored to repo root only — an unanchored `.claude/` here would also match
# extensions/.claude/, the tracked Claude Code adapter output, and silently
# exclude any *new* file added under it from `git add` (existing tracked files
# stay tracked, but new ones never get added). This exact bug caused
# extensions/.claude/defaults/generic_review_guidelines_theoretical.md to be
# missing from every clone until this fix — see a-green-hand-jack/paper-review#6.
/.claude/

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Open ScholarPeer run state
/.osp-run/

# API keys (never commit)
.env

# Node build/dependency output
node_modules/
/dist/

# Python build and runtime output.
# OSP itself is TypeScript, but harbor/osp_harbor/ is a Python Harbor adapter
# and importing it writes bytecode next to the source. Two .pyc files reached
# main this way once already; these rules are unanchored on purpose so they
# hold for any Python that appears anywhere in the tree, not just at the root.
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
